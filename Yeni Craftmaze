<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>CraftMaze - Stabil Sürüm</title>
  <style>
    :root{
      --bg:#0b0d10;
      --panel:#14171d;
      --panel2:#1b1f27;
      --text:#e5e7eb;
      --muted:#9ca3af;
      --accent:#f59e0b;
      --ok:#10b981;
      --danger:#ef4444;
      --line:#2a2f39;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:var(--bg);
      color:var(--text);
    }
    .wrap{
      max-width:1200px;
      margin:0 auto;
      padding:16px;
    }
    h1{
      margin:0 0 12px;
      font-size:clamp(20px,3vw,32px);
    }
    .grid{
      display:grid;
      gap:16px;
      grid-template-columns:320px 1fr;
    }
    @media (max-width: 980px){
      .grid{grid-template-columns:1fr}
    }
    .card{
      background:linear-gradient(180deg,var(--panel2),var(--panel));
      border:1px solid var(--line);
      border-radius:14px;
      padding:14px;
      box-shadow:0 8px 22px rgba(0,0,0,.35);
    }
    .card h2{
      margin:0 0 10px;
      font-size:14px;
      color:#fff;
      letter-spacing:.4px;
      text-transform:uppercase;
    }
    .row{display:flex; gap:8px; flex-wrap:wrap}
    button, select, input[type="file"]{
      width:100%;
      border:1px solid #374151;
      background:#0f1218;
      color:var(--text);
      border-radius:10px;
      padding:10px 12px;
      font-size:13px;
    }
    button{
      cursor:pointer;
      font-weight:700;
      transition:.15s ease;
    }
    button:hover{transform:translateY(-1px)}
    .btn-accent{background:#3b82f6; border-color:#2563eb}
    .btn-ok{background:var(--ok); border-color:#059669}
    .btn-danger{background:var(--danger); border-color:#dc2626}
    .btn-secondary{background:#374151; border-color:#4b5563}
    .tool.active{
      outline:2px solid var(--accent);
      border-color:var(--accent);
    }
    label{
      font-size:12px;
      color:var(--muted);
      display:block;
      margin:8px 0 6px;
    }
    .status{
      margin-top:8px;
      padding:8px 10px;
      border-radius:8px;
      font-size:12px;
      background:#111827;
      border:1px solid #374151;
      color:#d1d5db;
      min-height:34px;
      display:flex;
      align-items:center;
    }
    .status.ok{border-color:#065f46;color:#6ee7b7;background:#052e24}
    .status.err{border-color:#7f1d1d;color:#fca5a5;background:#2b0b0b}
    .canvas-wrap{
      background:#090b0f;
      border:1px dashed #374151;
      border-radius:12px;
      padding:12px;
      overflow:auto;
      max-height:78vh;
    }
    canvas{
      display:block;
      max-width:100%;
      height:auto;
      image-rendering:auto;
      border-radius:8px;
      cursor:crosshair;
    }
    .meta{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:10px;
      font-size:12px;
      color:var(--muted);
      gap:8px;
      flex-wrap:wrap;
    }
    code{
      background:#111827;
      border:1px solid #374151;
      padding:2px 6px;
      border-radius:6px;
      color:#fde68a;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>CraftMaze - Stabil HTML (GitHub Uyumlu)</h1>

    <div class="grid">
      <aside class="card">
        <h2>Kontroller</h2>

        <label for="sizeSelect">Labirent Boyutu</label>
        <select id="sizeSelect">
          <option value="29x15">29 x 15</option>
          <option value="45x23" selected>45 x 23</option>
          <option value="61x31">61 x 31</option>
          <option value="77x39">77 x 39</option>
        </select>

        <div class="row" style="margin-top:8px">
          <button id="btnGenerate" class="btn-accent">🎲 Yeni Labirent</button>
        </div>

        <label>Çizim Aracı</label>
        <div class="row">
          <button id="toolAdd" class="tool active">🧱 Duvar Koy</button>
          <button id="toolRemove" class="tool">⛏️ Blok Sil</button>
        </div>

        <label for="wallColor">Duvar Rengi</label>
        <select id="wallColor">
          <option value="#1f2937">Koyu Taş</option>
          <option value="#7c3aed">Ametist</option>
          <option value="#b45309">Bakır</option>
          <option value="#334155">Deepslate</option>
          <option value="#7f1d1d">Nether</option>
        </select>

        <label for="pathColor">Zemin Rengi</label>
        <select id="pathColor">
          <option value="#fbbf24">Kum</option>
          <option value="#22c55e">Çim</option>
          <option value="#e5e7eb">Kar</option>
          <option value="#d97706">Ahşap</option>
          <option value="#14b8a6">Prismarine</option>
        </select>

        <label for="thickness">Duvar Kalınlığı</label>
        <select id="thickness">
          <option value="half" selected>Yarı (%50)</option>
          <option value="threeQuarters">Orta (%75)</option>
          <option value="full">Tam (%100)</option>
        </select>

        <div class="row" style="margin-top:10px">
          <button id="btnClear" class="btn-danger">🧹 Tümünü Temizle</button>
          <button id="btnDownload" class="btn-ok">🖼️ PNG İndir</button>
          <button id="btnSaveProject" class="btn-secondary">💾 Proje Kaydet</button>
        </div>

        <label for="fileInput">Dosya Yükle (PNG / JSON / CRAFTMAZE)</label>
        <input id="fileInput" type="file" accept="image/*,.json,.craftmaze" />

        <div id="status" class="status">Hazır.</div>
      </aside>

      <main class="card">
        <div class="meta">
          <div>Çözünürlük: <strong id="gridInfo">45 x 23</strong></div>
          <div>Kaydetme: <code>craftmaze-*.png</code> / <code>*.craftmaze</code></div>
        </div>
        <div id="canvasWrap" class="canvas-wrap">
          <canvas id="mazeCanvas" width="1440" height="736"></canvas>
        </div>
      </main>
    </div>
  </div>

  <script>
    (() => {
      "use strict";

      const TILE_PATH = 0;
      const TILE_WALL = 1;
      const CELL = 32;

      const canvas = document.getElementById("mazeCanvas");
      const ctx = canvas.getContext("2d", { alpha: true });

      const sizeSelect = document.getElementById("sizeSelect");
      const wallColor = document.getElementById("wallColor");
      const pathColor = document.getElementById("pathColor");
      const thickness = document.getElementById("thickness");
      const gridInfo = document.getElementById("gridInfo");
      const status = document.getElementById("status");
      const fileInput = document.getElementById("fileInput");

      const toolAdd = document.getElementById("toolAdd");
      const toolRemove = document.getElementById("toolRemove");
      const btnGenerate = document.getElementById("btnGenerate");
      const btnClear = document.getElementById("btnClear");
      const btnDownload = document.getElementById("btnDownload");
      const btnSaveProject = document.getElementById("btnSaveProject");

      let cols = 45;
      let rows = 23;
      let grid = [];
      let tool = "add";
      let mouseDown = false;

      function setStatus(msg, type = "") {
        status.textContent = msg;
        status.className = "status" + (type ? " " + type : "");
      }

      function parseSize(v) {
        const [c, r] = v.split("x").map(Number);
        return { c, r };
      }

      function resizeCanvas() {
        canvas.width = cols * CELL;
        canvas.height = rows * CELL;
        gridInfo.textContent = `${cols} x ${rows}`;
      }

      function newGrid(fill = TILE_WALL) {
        grid = Array.from({ length: rows }, () => Array(cols).fill(fill));
      }

      function shuffle(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
      }

      function generateMaze() {
        const s = parseSize(sizeSelect.value);
        cols = s.c; rows = s.r;
        resizeCanvas();
        newGrid(TILE_WALL);

        function carve(r, c) {
          grid[r][c] = TILE_PATH;
          const dirs = shuffle([[0,2],[0,-2],[2,0],[-2,0]]);
          for (const [dr, dc] of dirs) {
            const nr = r + dr, nc = c + dc;
            if (nr > 0 && nr < rows - 1 && nc > 0 && nc < cols - 1 && grid[nr][nc] === TILE_WALL) {
              grid[r + dr / 2][c + dc / 2] = TILE_PATH;
              carve(nr, nc);
            }
          }
        }

        carve(1, 1);
        grid[1][1] = TILE_PATH;
        grid[rows - 2][cols - 2] = TILE_PATH;
        render();
        setStatus("✓ Yeni labirent oluşturuldu.", "ok");
      }

      function clearAll() {
        newGrid(TILE_PATH);
        render();
        setStatus("✓ Tüm bloklar temizlendi.", "ok");
      }

      function wallMargin() {
        if (thickness.value === "half") return Math.floor(CELL / 4);
        if (thickness.value === "threeQuarters") return Math.floor(CELL / 8);
        return 0;
      }

      function drawCellPath(x, y) {
        ctx.fillStyle = pathColor.value;
        ctx.fillRect(x, y, CELL, CELL);

        // Hafif doku
        ctx.fillStyle = "rgba(255,255,255,0.06)";
        for (let i = 0; i < 6; i++) {
          const rx = x + Math.random() * (CELL - 4);
          const ry = y + Math.random() * (CELL - 4);
          ctx.fillRect(rx, ry, 2, 2);
        }
      }

      function drawCellWall(r, c, x, y) {
        const m = wallMargin();
        const size = CELL - m * 2;

        ctx.fillStyle = wallColor.value;

        if (m === 0) {
          ctx.fillRect(x, y, CELL, CELL);
          return;
        }

        ctx.fillRect(x + m, y + m, size, size);

        const up = r > 0 && grid[r - 1][c] === TILE_WALL;
        const down = r < rows - 1 && grid[r + 1][c] === TILE_WALL;
        const left = c > 0 && grid[r][c - 1] === TILE_WALL;
        const right = c < cols - 1 && grid[r][c + 1] === TILE_WALL;

        if (up) ctx.fillRect(x + m, y, size, m);
        if (down) ctx.fillRect(x + m, y + CELL - m, size, m);
        if (left) ctx.fillRect(x, y + m, m, size);
        if (right) ctx.fillRect(x + CELL - m, y + m, m, size);
      }

      function render() {
        if (!grid.length) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const x = c * CELL;
            const y = r * CELL;
            drawCellPath(x, y);
          }
        }

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            if (grid[r][c] === TILE_WALL) {
              drawCellWall(r, c, c * CELL, r * CELL);
            }
          }
        }

        // Grid çizgisi
        ctx.strokeStyle = "rgba(0,0,0,.45)";
        ctx.lineWidth = 1;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            ctx.strokeRect(c * CELL + 0.5, r * CELL + 0.5, CELL - 1, CELL - 1);
          }
        }
      }

      function pointerToGrid(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        const sx = canvas.width / rect.width;
        const sy = canvas.height / rect.height;
        const x = (clientX - rect.left) * sx;
        const y = (clientY - rect.top) * sy;
        return { r: Math.floor(y / CELL), c: Math.floor(x / CELL) };
      }

      function paintAt(clientX, clientY) {
        const { r, c } = pointerToGrid(clientX, clientY);
        if (r < 0 || c < 0 || r >= rows || c >= cols) return;
        const v = tool === "add" ? TILE_WALL : TILE_PATH;
        if (grid[r][c] !== v) {
          grid[r][c] = v;
          render();
        }
      }

      canvas.addEventListener("mousedown", (e) => { mouseDown = true; paintAt(e.clientX, e.clientY); });
      canvas.addEventListener("mousemove", (e) => { if (mouseDown) paintAt(e.clientX, e.clientY); });
      window.addEventListener("mouseup", () => { mouseDown = false; });

      canvas.addEventListener("touchstart", (e) => {
        mouseDown = true;
        const t = e.touches[0];
        paintAt(t.clientX, t.clientY);
        e.preventDefault();
      }, { passive: false });

      canvas.addEventListener("touchmove", (e) => {
        if (!mouseDown) return;
        const t = e.touches[0];
        paintAt(t.clientX, t.clientY);
        e.preventDefault();
      }, { passive: false });

      canvas.addEventListener("touchend", () => { mouseDown = false; });

      function setTool(next) {
        tool = next;
        toolAdd.classList.toggle("active", next === "add");
        toolRemove.classList.toggle("active", next === "remove");
      }

      toolAdd.addEventListener("click", () => setTool("add"));
      toolRemove.addEventListener("click", () => setTool("remove"));

      btnGenerate.addEventListener("click", generateMaze);
      btnClear.addEventListener("click", clearAll);
      wallColor.addEventListener("change", render);
      pathColor.addEventListener("change", render);
      thickness.addEventListener("change", render);
      sizeSelect.addEventListener("change", generateMaze);

      function saveProject() {
        const data = {
          version: "3.0-stable",
          cols, rows, grid,
          wallColor: wallColor.value,
          pathColor: pathColor.value,
          thickness: thickness.value
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `craftmaze-${cols}x${rows}.craftmaze`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        setStatus("✓ Proje dosyası kaydedildi.", "ok");
      }

      btnSaveProject.addEventListener("click", saveProject);

      function embedHeader(expCtx, w) {
        expCtx.fillStyle = "rgb(67,82,65)"; expCtx.fillRect(0, 0, 1, 1); // C R A
        expCtx.fillStyle = `rgb(${cols},0,0)`; expCtx.fillRect(1, 0, 1, 1);
        expCtx.fillStyle = `rgb(${rows},0,0)`; expCtx.fillRect(2, 0, 1, 1);
        expCtx.fillStyle = "rgb(255,255,255)"; expCtx.fillRect(3, 0, 1, 1);

        let i = 0;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const px = (i + 4) % w;
            const py = Math.floor((i + 4) / w);
            const v = grid[r][c] === TILE_WALL ? 255 : 0;
            expCtx.fillStyle = `rgb(${v},${v},${v})`;
            expCtx.fillRect(px, py, 1, 1);
            i++;
          }
        }
      }

      function downloadPNG() {
        const maxW = 3840;
        const s = Math.min(80, Math.max(20, Math.floor(maxW / cols)));
        const out = document.createElement("canvas");
        out.width = cols * s;
        out.height = rows * s;
        const expCtx = out.getContext("2d");

        // zemin
        expCtx.fillStyle = pathColor.value;
        expCtx.fillRect(0, 0, out.width, out.height);

        // duvarlar
        const m = thickness.value === "half" ? Math.floor(s / 4) : thickness.value === "threeQuarters" ? Math.floor(s / 8) : 0;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            if (grid[r][c] !== TILE_WALL) continue;
            const x = c * s, y = r * s;
            expCtx.fillStyle = wallColor.value;

            if (m === 0) {
              expCtx.fillRect(x, y, s, s);
            } else {
              const w = s - m * 2;
              expCtx.fillRect(x + m, y + m, w, w);

              const up = r > 0 && grid[r - 1][c] === TILE_WALL;
              const down = r < rows - 1 && grid[r + 1][c] === TILE_WALL;
              const left = c > 0 && grid[r][c - 1] === TILE_WALL;
              const right = c < cols - 1 && grid[r][c + 1] === TILE_WALL;

              if (up) expCtx.fillRect(x + m, y, w, m);
              if (down) expCtx.fillRect(x + m, y + s - m, w, m);
              if (left) expCtx.fillRect(x, y + m, m, w);
              if (right) expCtx.fillRect(x + s - m, y + m, m, w);
            }
          }
        }

        // çizgiler
        expCtx.strokeStyle = "rgba(0,0,0,.45)";
        expCtx.lineWidth = Math.max(1, Math.floor(s * 0.03));
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const lw = expCtx.lineWidth / 2;
            expCtx.strokeRect(c * s + lw, r * s + lw, s - expCtx.lineWidth, s - expCtx.lineWidth);
          }
        }

        // çözünürlük/header gömme
        embedHeader(expCtx, out.width);

        out.toBlob((blob) => {
          if (!blob) {
            setStatus("⚠️ PNG oluşturulamadı.", "err");
            return;
          }
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `craftmaze-${cols}x${rows}.png`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          setStatus("✓ PNG indirildi.", "ok");
        }, "image/png");
      }

      btnDownload.addEventListener("click", downloadPNG);

      function loadProjectObject(data) {
        if (!data || !Array.isArray(data.grid) || !data.cols || !data.rows) {
          throw new Error("Geçersiz proje formatı");
        }
        cols = Number(data.cols);
        rows = Number(data.rows);
        grid = data.grid;
        resizeCanvas();

        // select'i en yakın boyuta getir
        const key = `${cols}x${rows}`;
        const opt = Array.from(sizeSelect.options).find(o => o.value === key);
        if (opt) sizeSelect.value = key;

        if (typeof data.wallColor === "string") wallColor.value = data.wallColor;
        if (typeof data.pathColor === "string") pathColor.value = data.pathColor;
        if (typeof data.thickness === "string") thickness.value = data.thickness;

        render();
      }

      function parseImageToGrid(img) {
        const w = img.naturalWidth || img.width;
        const h = img.naturalHeight || img.height;
        const t = document.createElement("canvas");
        t.width = w; t.height = h;
        const tctx = t.getContext("2d");
        tctx.drawImage(img, 0, 0);

        let header;
        try { header = tctx.getImageData(0, 0, 4, 1).data; }
        catch { throw new Error("Görsel piksel verisi okunamadı"); }

        const hasHeader = Math.abs(header[0] - 67) <= 4 && Math.abs(header[1] - 82) <= 4 && Math.abs(header[2] - 65) <= 4;

        if (hasHeader) {
          const p1 = tctx.getImageData(1, 0, 1, 1).data;
          const p2 = tctx.getImageData(2, 0, 1, 1).data;
          cols = p1[0] || cols;
          rows = p2[0] || rows;
          resizeCanvas();
          grid = Array.from({ length: rows }, () => Array(cols).fill(TILE_PATH));

          let i = 0;
          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const px = (i + 4) % w;
              const py = Math.floor((i + 4) / w);
              const d = tctx.getImageData(px, py, 1, 1).data;
              grid[r][c] = d[0] > 128 ? TILE_WALL : TILE_PATH;
              i++;
            }
          }
          render();
          setStatus("✓ Gömülü veri ile harita yüklendi.", "ok");
          return;
        }

        // header yoksa mevcut grid ölçüsüyle parlaklık analizi
        const cw = w / cols;
        const ch = h / rows;
        grid = Array.from({ length: rows }, () => Array(cols).fill(TILE_PATH));

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const sx = Math.floor(c * cw + cw / 2);
            const sy = Math.floor(r * ch + ch / 2);
            const p = tctx.getImageData(sx, sy, 1, 1).data;
            const b = (p[0] + p[1] + p[2]) / 3;
            grid[r][c] = b < 120 ? TILE_WALL : TILE_PATH;
          }
        }
        render();
        setStatus("✓ Görsel parlaklık analizi ile yüklendi.", "ok");
      }

      async function loadFile(file) {
        const name = (file.name || "").toLowerCase();

        if (name.endsWith(".json") || name.endsWith(".craftmaze")) {
          const text = await file.text();
          const data = JSON.parse(text);
          loadProjectObject(data);
          setStatus("✓ Proje dosyası yüklendi.", "ok");
          return;
        }

        if (file.type.startsWith("image/")) {
          const dataUrl = await new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => resolve(fr.result);
            fr.onerror = reject;
            fr.readAsDataURL(file);
          });
          const img = new Image();
          img.onload = () => parseImageToGrid(img);
          img.onerror = () => setStatus("⚠️ Görsel yüklenemedi.", "err");
          img.src = dataUrl;
          return;
        }

        setStatus("⚠️ Desteklenmeyen dosya türü.", "err");
      }

      fileInput.addEventListener("click", () => { fileInput.value = ""; });
      fileInput.addEventListener("change", async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        try {
          await loadFile(file);
        } catch (err) {
          setStatus("⚠️ Yükleme hatası: " + (err.message || err), "err");
        }
      });

      // drag & drop
      const canvasWrap = document.getElementById("canvasWrap");
      canvasWrap.addEventListener("dragover", (e) => { e.preventDefault(); });
      canvasWrap.addEventListener("drop", async (e) => {
        e.preventDefault();
        const file = e.dataTransfer?.files?.[0];
        if (!file) return;
        try {
          await loadFile(file);
        } catch (err) {
          setStatus("⚠️ Bırak-yükle hatası: " + (err.message || err), "err");
        }
      });

      // ilk açılış
      resizeCanvas();
      generateMaze();
    })();
  </script>
</body>
</html>
